%YAML 1.1
--- !XShader &1
name: noface/xshader
guid: {a: 10035637419972439794, b: 6659393957449183874}
renderQueue: 2000
passes:
  - __class: Pass
    name: embossment
    guid: {a: 7155752742063804705, b: 9449911248642731910}
    shaders:
      __class: Map
      gles2:
        - {localId: 2}
        - {localId: 3}
    angleBinaryPrograms:
      __class: Map
    semantics:
      __class: Map
      position:
        __class: VertexAttribType
        value: POSITION
      texcoord0:
        __class: VertexAttribType
        value: TEXCOORD0
    clearColor: {r: 0, g: 0, b: 0, a: 0}
    clearDepth: 1
    clearType:
      __class: CameraClearType
      value: COLOR
    renderState:
      __class: RenderState
      name: ""
      guid: {a: 17386364185091588963, b: 4859338549016411054}
      depthstencil:
        __class: DepthStencilState
        name: ""
        guid: {a: 11764958612208453534, b: 4771028555254975385}
        depthTestEnable: false
        depthTestEnableName: ""
        depthCompareOp:
          __class: CompareOp
          value: LESS
        depthCompareOpName: ""
        depthWriteEnable: false
        stencilTestEnable: false
        stencilTestEnableName: ""
      colorBlend:
        __class: ColorBlendState
        name: ""
        guid: {a: 15728243450178909638, b: 3563297688766109887}
        blendConstants: {x: 0, y: 0, z: 0, w: 0}
        blendEnableName: ""
        blendFactorName: ""
        blendOpName: ""
        attachments:
          - __class: ColorBlendAttachmentState
            name: ""
            guid: {a: 11835705335990223118, b: 1707625064565292718}
            blendEnable: true
            srcColorBlendFactor:
              __class: BlendFactor
              value: ONE
            dstColorBlendFactor:
              __class: BlendFactor
              value: ONE_MINUS_SRC_ALPHA
            srcAlphaBlendFactor:
              __class: BlendFactor
              value: ONE
            dstAlphaBlendFactor:
              __class: BlendFactor
              value: ONE_MINUS_SRC_ALPHA
            colorWriteMask: 15
            ColorBlendOp:
              __class: BlendOp
              value: ADD
            AlphaBlendOp:
              __class: BlendOp
              value: ADD
    useFBOTexture: false
    useCameraRT: false
    useFBOFetch: false
    enableFBOFetch: false
    isFullScreenShading: false
    macrosMap:
      __class: Map
    preprocess: false
    passType:
      __class: PassType
      value: NORMAL
    lightMode:
      __class: LightMode
      value: NONE
    clearMoment:
      __class: PassClearMoment
      value: CLEAR_BEFORE_RENDERING
--- !Shader &2
name: ""
guid: {a: 16880610216157218316, b: 5434446548915835298}
type:
  __class: ShaderType
  value: VERTEX
sourcePath: xshader/quad.vert
--- !Shader &3
name: ""
